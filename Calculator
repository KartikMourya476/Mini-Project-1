<div id="app"></div>

<script>

// Create Calculator Using DOM
const calculator = document.createElement("div");
calculator.className = "calculator";

const display = document.createElement("input");
display.id = "display";
display.type = "text";
display.readOnly = true;

calculator.appendChild(display);

const btnContainer = document.createElement("div");
btnContainer.className = "buttons";

const buttons = [
    "7","8","9","/",
    "4","5","6","*",
    "1","2","3","-",
    "0","%","=","+",
    "C"
];

buttons.forEach(text=>{
    const btn = document.createElement("button");
    btn.innerText = text;

    if(text==="=") btn.classList.add("equal");
    if(text==="C") btn.classList.add("clear");

    btn.addEventListener("click",()=>handleButton(text));

    btnContainer.appendChild(btn);
});

calculator.appendChild(btnContainer);
document.getElementById("app").appendChild(calculator);

// Button Operations
function handleButton(value){

    if(value==="C"){
        display.value="";
    }
    else if(value==="="){
        try{
            display.value = eval(display.value);
        }
        catch{
            display.value="Error";
        }
    }
    else{
        display.value += value;
    }
}

// Keyboard Events
document.addEventListener("keydown",(e)=>{

    const allowedNumbers = /^[0-9]$/;

    if(allowedNumbers.test(e.key)){
        display.value += e.key;
    }
    else{
        alert("Only numbers are allowed");
    }
});

</script>

</body>
</html>
